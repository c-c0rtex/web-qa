#!/usr/bin/env bash
# Phase 5: heal failing specs from real playwright error context.
# Default proposes fixes as *.spec.ts.proposed; --apply overwrites in place (keeps .bak).
# Usage: web-qa-maintain --alias <name> [--report <json>] [--apply] [--workers N]
set -e
SKILL="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." &> /dev/null && pwd)"
exec uv run --project "$SKILL" python -u "$SKILL/runners/maintain.py" "$@"
