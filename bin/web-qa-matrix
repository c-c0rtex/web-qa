#!/usr/bin/env bash
# Pre-deploy test matrix: inventory + run of ALL project tests (scenario TCs + specs).
# Exit 0 = gate pass, 1 = failures (block deploy), 2 = no tests / bad alias.
# Usage: web-qa-matrix --alias <name> [--list] [--include-adhoc] [--skip-passive|--skip-specs]
set -e
SKILL="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." &> /dev/null && pwd)"
exec uv run --project "$SKILL" python -u "$SKILL/runners/matrix.py" "$@"
