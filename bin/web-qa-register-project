#!/usr/bin/env python3
"""Register a project in web-qa.

Usage:
  web-qa-register-project <alias> --target-url <url> [--backend-url <url>] [--path <abs>] [--auth-cmd <cmd>]
  web-qa-register-project <alias> --remove

Stores in ~/.claude/skills/web-qa/projects.json. Also creates <project_path>/.web-qa/ skeleton:
  config.json — project-specific settings
  app.context.md — empty (Exploration agent fills in)
  scenarios/, baseline/, reports/, fixtures/ — empty dirs
"""

from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "runners"))
from registry import registry_write_path  # noqa: E402

REGISTRY = registry_write_path()


def load() -> list[dict]:
    if not REGISTRY.exists():
        return []
    try:
        return json.loads(REGISTRY.read_text())
    except json.JSONDecodeError:
        return []


def save(entries: list[dict]) -> None:
    REGISTRY.parent.mkdir(parents=True, exist_ok=True)
    REGISTRY.write_text(json.dumps(entries, ensure_ascii=False, indent=2))


# Scaffolded config.json: PROJECT-level keys only (null = unset, ignored by the merge).
# Only `path` and `auth`/`roles` stay in the registry — a committed config.json must never
# leak a machine path or a credential into the project repo. URLs are neither.
CONFIG_SKELETON = {
    "target_url": None,
    "backend_url": None,
    "stack": None,
    "language": None,
    "frontend_dir": None,
    "workers": None,
    "backend_prefixes": None,
    "route_hints": None,
    "id_discovery": None,
    "auth_flow_notes": None,
    "auth_login_hint": None,
    "auth_login_path": None,
    "auth_login_body": None,
    "auth_token_field": None,
    "auth_me_path": None,
    "auth_browser_storage": None,
    "context_notes": None,
    "visual_masks": None,
    "visual_exclude": None,
    "gate_exclude": None,
    "test_data_prefix": None,
    "viewport": None,
    "viewports": None,
    "network_fail_on": None,
    "console_fail_on": None,
    "console_ignore": None,
    "quarantine_after": None,
}


def init_project_dir(project_path: Path, alias: str, *, target_url: str | None = None,
                     backend_url: str | None = None) -> None:
    web_qa = project_path / ".web-qa"
    web_qa.mkdir(parents=True, exist_ok=True)
    for sub in ("scenarios", "baseline", "reports", "fixtures"):
        (web_qa / sub).mkdir(exist_ok=True)
    cfg_file = web_qa / "config.json"
    if not cfg_file.exists():
        cfg = dict(CONFIG_SKELETON, target_url=target_url, backend_url=backend_url)
        cfg_file.write_text(json.dumps(cfg, ensure_ascii=False, indent=2) + "\n")
    else:
        # re-register: keep the file, only fill URLs the user has not set
        cfg = json.loads(cfg_file.read_text())
        changed = False
        for k, v in (("target_url", target_url), ("backend_url", backend_url)):
            if v and not cfg.get(k):
                cfg[k] = v
                changed = True
        if changed:
            cfg_file.write_text(json.dumps(cfg, ensure_ascii=False, indent=2) + "\n")
    ctx_file = web_qa / "app.context.md"
    if not ctx_file.exists():
        ctx_file.write_text(
            f"# {alias} — App Context\n\n"
            "<i>Generated by Exploration agent.</i>\n\n"
            "## Routes\n_(empty)_\n\n## User Roles\n_(empty)_\n\n## Auth Flow\n_(empty)_\n\n"
            "## Scope\n_(empty)_\n\n## Out of Scope\n_(empty)_\n"
        )
    gitignore = web_qa / ".gitignore"
    if not gitignore.exists():
        gitignore.write_text("# web-qa runtime artifacts (keep app.context.md, scenarios/, baseline/ in git)\n"
                             "reports/\n"
                             "fixtures/.cache/\n"
                             "*.tmp\n")


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("alias")
    ap.add_argument("--target-url", help="Frontend URL (e.g. http://127.0.0.1:3000)")
    ap.add_argument("--backend-url", help="Backend API URL (e.g. http://127.0.0.1:8000)")
    ap.add_argument("--path", default=os.getcwd(), help="Absolute project path (default: cwd)")
    ap.add_argument("--auth-cmd", help="Shell cmd to obtain auth (returns storageState JSON path or env)")
    ap.add_argument("--remove", action="store_true", help="Remove this alias from registry")
    args = ap.parse_args()

    entries = load()

    if args.remove:
        new_entries = [e for e in entries if e.get("alias") != args.alias]
        save(new_entries)
        print(json.dumps({"removed": args.alias, "remaining": len(new_entries)}, ensure_ascii=False))
        return 0

    if not args.target_url:
        print("--target-url is required (unless --remove).", file=sys.stderr)
        return 64

    abs_path = os.path.abspath(args.path)
    # Registry = machine path + secrets, nothing else. Everything a teammate could also
    # use lives in the project's own .web-qa/config.json.
    record = {
        "alias": args.alias,
        "path": abs_path,
        "auth": {"cmd": args.auth_cmd} if args.auth_cmd else None,
    }

    handled = False
    out: list[dict] = []
    for e in entries:
        if e.get("alias") == args.alias or (e.get("path") == abs_path and abs_path):
            out.append(record)
            handled = True
        else:
            out.append(e)
    if not handled:
        out.append(record)

    save(out)
    init_project_dir(Path(abs_path), args.alias,
                     target_url=args.target_url, backend_url=args.backend_url)

    print(json.dumps({
        "registered": args.alias,
        "path": abs_path,
        "target_url": args.target_url,
        "backend_url": args.backend_url,
        "web_qa_dir": str(Path(abs_path) / ".web-qa"),
    }, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
